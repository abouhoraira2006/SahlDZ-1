{
    "name": "sahldz-desktop",
    "version": "1.0.1",
    "description": "SahlDZ - نظام إدارة المطعم",
    "main": "main.js",
    "author": "SahlDZ Team",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "dev": "set VITE_DEV_SERVER_URL=http://localhost:8080 && electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win",
        "fetch:sumatra": "node scripts/fetch-sumatra.cjs",
        "prebuild": "node scripts/fetch-sumatra.cjs"
    },
    "dependencies": {
        "electron-updater": "^6.1.0"
    },
    "devDependencies": {
        "electron": "22.3.27",
        "electron-builder": "^24.0.0"
    },
    "build": {
        "appId": "com.sahldz.app",
        "productName": "SahlDZ",
        "directories": {
            "output": "release-build"
        },
        "files": [
            "main.js",
            "preload.js",
            "src/**/*"
        ],
        "extraResources": [
            {
                "from": "resources/sumatra",
                "to": "sumatra",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "ia32"
                    ]
                }
            ],
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "SahlDZ",
            "unicode": true
        },
        "publish": [
            {
                "provider": "generic",
                "url": "https://sahldz.com/updates"
            }
        ]
    }
}